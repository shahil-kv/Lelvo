{
  "$comment": "Memvo's design tokens, the one place colours and web type are defined. After editing, run python3 Scripts/design-tokens.py, which writes the app colour assets and the :root block of website/styles.css. Roles and rules: docs/DESIGN.md.",
  "app": {
    "colors": {
      "AccentColor": { "light": "#5E4AE3", "dark": "#8B7CFF" }
    }
  },
  "web": {
    "paper": "#F4F5F7",
    "surface": "#FFFFFF",
    "ink": "#161B2B",
    "slate": "#586276",
    "line": "#DCE0E7",
    "signal": "#5E4AE3",
    "signal-soft": "#ECE9FD",
    "on-signal": "#FFFFFF",
    "verified": "#1E8A4C",
    "band": "#1D1846",
    "band-ink": "#F1EFFF",
    "band-mist": "#C3BDEB",
    "band-link": "#B9B0FF",
    "bezel": "#0E1420",
    "bezel-edge": "rgba(14, 20, 32, 0)",
    "shadow": "rgba(22, 27, 43, 0.22)",
    "display": "\"Bricolage Grotesque\", ui-sans-serif, system-ui, sans-serif",
    "text": "\"Source Serif 4\", ui-serif, Georgia, serif",
    "measure": "34rem",
    "gutter": "clamp(1rem, 4vw, 3rem)",
    "wide": "78rem",
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "web-dark": {
    "$comment": "Overrides for the website's dark theme (the toggle sets data-theme=\"dark\"). Only colours change.",
    "paper": "#0E121C",
    "surface": "#171C29",
    "ink": "#E9ECF2",
    "slate": "#9AA4B6",
    "line": "#283043",
    "signal": "#8B7CFF",
    "signal-soft": "#231F45",
    "on-signal": "#0E121C",
    "verified": "#4CC27E",
    "band": "#1A1640",
    "bezel": "#05070C",
    "bezel-edge": "rgba(255, 255, 255, 0.12)",
    "shadow": "rgba(0, 0, 0, 0.55)"
  },
  "icon": {
    "$comment": "App icon background, top-left to bottom-right. The icon PNGs use these colours; the script doesn't draw them.",
    "gradient": ["#4D44EF", "#4B2CC8"]
  }
}
