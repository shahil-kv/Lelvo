<?xml version="1.0" encoding="utf-8"?>
<!-- A TextureView, not Media3's default SurfaceView: a SurfaceView sits outside the Compose layout, so while the
     viewer pages sideways the video drew over its neighbours and lagged behind the finger. The surface type can only
     be set from XML. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/transparent" />
