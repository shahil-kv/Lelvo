<resources>
    <!-- Android 12+ draws its own splash screen from these. Same picture as the iPhone's launch screen; the opening
         (LaunchOverlay) starts from exactly this frame. -->
    <style name="Theme.Lelvo.Launch">
        <item name="android:windowSplashScreenBackground">@color/launch</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
