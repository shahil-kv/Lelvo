// The Memvo website (website/), served as static files by Cloudflare. Cloudflare Workers Builds deploys it on every push to main.
{
  "name": "memvo",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "website",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
